func @forward(%x: f32[1000,784], %weight: f32[784,256] {param}, %bias: f32[256] {param}, %weight_1: f32[256,10] {param}, %bias_1: f32[10] {param}) -> f32[1000,10] {
  %0 = matmul(%x, %weight) : f32[1000,256]
  %1 = add(%0, %bias) : f32[1000,256]
  %2 = relu(%1) : f32[1000,256]
  %3 = matmul(%2, %weight_1) : f32[1000,10]
  %4 = add(%3, %bias_1) : f32[1000,10]
  return %4
}
