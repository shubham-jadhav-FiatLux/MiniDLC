// Each function of a module is fused and planned on its own: kernel ids and buffer offsets restart per function.
// RUN: %dlc-opt --passes=fusion,buffer-assign %s | FileCheck %s
// RUN: %dlc-opt --print-mem-report %s | FileCheck %s --check-prefix=REPORT

// CHECK-LABEL: func @layer
// CHECK:       %2 = relu(%1) : f32[4,16] {fusion.group = 0, fusion.kernel = "k0_matmul_add_relu", mem.offset = {{[0-9]+}}, mem.region = "transient", mem.size = 256}
// CHECK-LABEL: func @scale
// CHECK:       %0 = mul(%p, %q) : f32[64] {fusion.group = 0, fusion.kernel = "k0_mul", mem.offset = {{[0-9]+}}, mem.region = "transient", mem.size = 256}

// REPORT: Buffer assignment for @layer (1 kernels, 256-byte alignment)
// REPORT: Buffer assignment for @scale (1 kernels, 256-byte alignment)

func @layer(%x: f32[4,8], %w: f32[8,16], %b: f32[16]) -> f32[4,16] {
  %0 = matmul(%x, %w) : f32[4,16]
  %1 = add(%0, %b) : f32[4,16]
  %2 = relu(%1) : f32[4,16]
  return %2
}

func @scale(%p: f32[64], %q: f32[64]) -> f32[64] {
  %0 = mul(%p, %q) : f32[64]
  return %0
}
