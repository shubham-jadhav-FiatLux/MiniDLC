// RUN: %dlc-opt --emit-loopir %s | FileCheck %s

// Each function is fused and lowered with its own groups.
// CHECK:      kernel @fused_matmul_bias_relu {
// CHECK:        acc = fma(x[((i * 8) + k)], w[((k * 16) + j)], acc);
// CHECK:        2[((i * 16) + j)] = max((acc + b[j]), 0.0);
// CHECK:      kernel @fused_elementwise_mul {
// CHECK:        0[idx] = (p[idx] * q[idx]);

func @layer(%x: f32[4,8], %w: f32[8,16], %b: f32[16]) -> f32[4,16] {
  %0 = matmul(%x, %w) : f32[4,16]
  %1 = add(%0, %b) : f32[4,16]
  %2 = relu(%1) : f32[4,16]
  return %2
}

func @scale(%p: f32[64], %q: f32[64]) -> f32[64] {
  %0 = mul(%p, %q) : f32[64]
  return %0
}
