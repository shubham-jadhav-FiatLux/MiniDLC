// RUN: %dlc-opt --passes=shape-infer %s | FileCheck %s

// CHECK: func @test_layer(%arg0: f32[128,784], %arg1: f32[784,256], %arg2: f32[256]) -> f32[128,256] {
// CHECK:   %0 = matmul(%arg0, %arg1) : f32[128,256]
// CHECK:   %1 = add(%0, %arg2) : f32[128,256]
// CHECK:   %2 = relu(%1) : f32[128,256]
// CHECK:   return(%2)
// CHECK: }

func @test_layer(%x: f32[128,784], %w: f32[784,256], %b: f32[256]) -> f32[128,256] {
  %0 = matmul(%x, %w) : f32[128,256]
  %1 = add(%0, %b) : f32[128,256]
  %2 = relu(%1) : f32[128,256]
  return %2
}
