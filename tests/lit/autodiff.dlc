// RUN: %dlc-opt --passes=autodiff %s | FileCheck %s

// XFAIL: *
// Target behaviour for P2: activity analysis gives a gradient only for the parameter %w, and the ReLU backward masks
// the upstream gradient with a compare/select instead of multiplying by the input. Remove the XFAIL line with P2.

// CHECK: func @test_autodiff(%x: f32[128,784], %w: f32[784,256] {param}) -> (f32[], f32[784,256]) {
// CHECK:   %0 = matmul(%x, %w) : f32[128,256]
// CHECK:   %1 = relu(%0) : f32[128,256]
// CHECK:   %2 = sum(%1) : f32[]
// CHECK:   cmp_gt(%0
// CHECK:   select(
// CHECK:   return %2, %

func @test_autodiff(%x: f32[128,784], %w: f32[784,256] {param}) -> f32[] {
  %0 = matmul(%x, %w) : f32[128,256]
  %1 = relu(%0) : f32[128,256]
  %2 = sum(%1) : f32[]
  return %2
}
