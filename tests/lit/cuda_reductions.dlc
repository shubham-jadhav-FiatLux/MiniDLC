// Row kernels and reductions on the GPU: one warp per row. Each lane strides over the row (guarded past its end),
// then five butterfly shuffles leave the warp's maximum (or sum) in every lane. exp goes through ex2.approx: NVPTX
// has no libm.
// RUN: %dlc-opt --target=gpu --emit-loopir %s | FileCheck %s
// RUN: %dlc-opt --target=gpu --emit-ptx %s | FileCheck %s --check-prefix=PTX

// CHECK-LABEL: kernel @k0_softmax(%x: f32[37,100], %0: f32[37,100]) grid(37,1,1) block(32,1,1) {
// CHECK:       f32 m = -inf;
// CHECK:       for t in 0..4 {
// CHECK:         i64 l = ((t * 32) + tx);
// CHECK:         if (l < 100) {
// CHECK:           m = max_nan(m, %x[((o * 100) + l)]);
// CHECK:       m = max_nan(m, shfl_xor(m, 16));
// CHECK:       m = max_nan(m, shfl_xor(m, 1));
// CHECK:       s = (s + shfl_xor(s, 16));
// CHECK:           %0[((o * 100) + l)] = (exp((%x[((o * 100) + l)] - m)) / s);
// CHECK-LABEL: kernel @k1_sum(%x: f32[37,100], %1: f32[37]) grid(37,1,1) block(32,1,1) {
// CHECK:       acc = (acc + shfl_xor(acc, 16));
// CHECK:       if (tx == 0) {
// CHECK:         %1[bx] = acc;

// PTX-LABEL: .entry k0_softmax(
// PTX: shfl.sync.bfly.b32 {{.*}}, 16, 31, -1;
// PTX: ex2.approx.f32
// PTX: div.rn.f32
// PTX-LABEL: .entry k1_sum(
// PTX: shfl.sync.bfly.b32 {{.*}}, 1, 31, -1;

func @f(%x: f32[37,100]) -> (f32[37,100], f32[37]) {
  %0 = softmax(%x) : f32[37,100] {axis = 1}
  %1 = sum(%x) : f32[37] {axes = [1]}
  return %0, %1
}
