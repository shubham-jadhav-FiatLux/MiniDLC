// The v1 LLVM emitter picked a text template by kernel name and turned div into fadd (a known bug from the
// 2026-10-17 audit). The emitter translates the loop IR, so the kernel divides — vectorized by the schedule's
// vectorize(8), which reaches LLVM as loop metadata.
// RUN: %dlc-opt --emit-llvm %s | FileCheck %s
// RUN: %dlc-opt --emit-llvm-opt %s | FileCheck %s --check-prefix=OPT

// CHECK:     define internal void @k0_div.body(ptr noalias %0, ptr noalias %1, ptr noalias %2, i64 %3, i64 %4)
// CHECK:     fdiv float
// CHECK:     define void @k0_div(ptr %0, i64 %1, i64 %2)
// CHECK:     !{!"llvm.loop.vectorize.width", i32 8}
// OPT:       fdiv <8 x float>

func @d(%a: f32[64], %b: f32[64]) -> f32[64] {
  %0 = div(%a, %b) : f32[64]
  return %0
}
